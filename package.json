{
  "name": "delay-tolerant-mission-network-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Jason Stys",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "format": "prettier --write .",
