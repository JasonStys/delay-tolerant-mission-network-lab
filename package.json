    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "prettier": "3.9.10"
  }
}
